---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "API reference",
    description:
      "Search, inspect, and test the Ekubo and Quoter APIs from their OpenAPI specifications.",
    editUrl: false,
    pagefind: false,
    tableOfContents: false,
  }}
  hasSidebar={false}
>
  <p class="api-intro">
    Search, inspect, and test both APIs in one place. Choose a specification in
    the explorer, or download the machine-readable{" "}
    <a href="/openapi/ekubo.json">Ekubo API</a> and
    {" "}<a href="/openapi/quoter.json">Quoter API</a> OpenAPI documents.
  </p>

  <span id="quoter" class="api-spec-anchor" aria-hidden="true"></span>
  <div class="api-reference-frame">
    <div id="scalar-reference" aria-label="Interactive API reference"></div>
  </div>

  <noscript>
    <p>
      The interactive reference requires JavaScript. Use the OpenAPI document
      links above instead.
    </p>
  </noscript>

  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/@scalar/api-reference@1.64.1"></script>
  <script is:inline>
    const container = document.querySelector("#scalar-reference");

    if (container && !container.dataset.mounted && window.Scalar) {
      container.dataset.mounted = "true";
      window.Scalar.createApiReference(container, {
        sources: [
          {
            title: "Ekubo API",
            slug: "ekubo",
            url: "/openapi/ekubo.json",
            default: true,
          },
          {
            title: "Quoter API",
            slug: "quoter",
            url: "/openapi/quoter.json",
          },
        ],
        theme: "default",
        layout: "modern",
        darkMode: document.documentElement.dataset.theme !== "light",
        hideDarkModeToggle: true,
        withDefaultFonts: false,
        modelsSectionLabel: "Schemas",
        showOperationId: true,
        showDeveloperTools: "never",
        telemetry: false,
        agent: { disabled: true },
      });
    }

    let repairQueued = false;
    function repairAccessibility() {
      repairQueued = false;
      for (const main of container?.querySelectorAll("main") ?? []) {
        const region = document.createElement("div");
        for (const attribute of main.attributes) {
          region.setAttribute(attribute.name, attribute.value);
        }
        region.setAttribute("role", "region");
        region.setAttribute("aria-label", "API specification");
        region.append(...main.childNodes);
        main.replaceWith(region);
      }
      let previousHeadingLevel = 0;
      for (const heading of container?.querySelectorAll(
        "h1, h2, h3, h4, h5, h6",
      ) ?? []) {
        const naturalLevel = Number(heading.tagName.slice(1));
        const level =
          previousHeadingLevel && naturalLevel > previousHeadingLevel + 1
            ? previousHeadingLevel + 1
            : naturalLevel;
        heading.setAttribute("aria-level", String(level));
        previousHeadingLevel = level;
      }
      for (const button of container?.querySelectorAll("button") ?? []) {
        if (
          !button.getAttribute("aria-label") &&
          (button.classList.contains("scalar-code-copy") ||
            !button.textContent?.trim())
        ) {
          button.setAttribute("aria-label", "Copy code");
        }
      }
      for (const link of container?.querySelectorAll("a[href]") ?? []) {
        if (!link.getAttribute("aria-label") && !link.textContent?.trim()) {
          const href = link.getAttribute("href");
          let label = "Open link";
          if (href?.startsWith("mailto:")) {
            label = "Email API support";
          } else if (href) {
            try {
              label = `Visit ${new URL(href, location.href).hostname}`;
            } catch {}
          }
          link.setAttribute("aria-label", label);
        }
      }
      for (const endpoint of container?.querySelectorAll(
        "a.endpoint:not([href])",
      ) ?? []) {
        const group = endpoint.closest("section[id]");
        const method = endpoint
          .querySelector(".endpoint-method")
          ?.textContent?.trim()
          .toUpperCase();
        const path = endpoint
          .querySelector(".endpoint-path")
          ?.textContent?.trim();
        const target =
          group?.id && method && path
            ? `${group.id}/${method}${path}`
            : undefined;
        if (target && document.getElementById(target)) {
          endpoint.setAttribute("href", `#${target}`);
        }
      }
      const regions = new Map();
      for (const region of container?.querySelectorAll('[role="region"]') ??
        []) {
        const id = region.getAttribute("aria-labelledby");
        const label =
          region.getAttribute("aria-label") ||
          (id && document.getElementById(id)?.textContent?.trim());
        if (!label) continue;
        const group = regions.get(label) ?? [];
        group.push(region);
        regions.set(label, group);
      }
      for (const [label, group] of regions) {
        if (group.length < 2) continue;
        group.forEach((region, index) => {
          region.setAttribute("aria-label", `${label} ${index + 1}`);
          region.removeAttribute("aria-labelledby");
        });
      }
      for (const element of container?.querySelectorAll("pre, table") ?? []) {
        if (element.scrollWidth > element.clientWidth) element.tabIndex = 0;
      }
    }

    const observer = new MutationObserver(() => {
      if (repairQueued) return;
      repairQueued = true;
      requestAnimationFrame(repairAccessibility);
    });
    if (container) {
      observer.observe(container, { childList: true, subtree: true });
      repairAccessibility();
    }
  </script>
</StarlightPage>

<style is:global>
  body {
    line-height: 1.75;
  }

  .api-intro {
    color: var(--sl-color-gray-2);
    max-width: 52rem;
  }

  .api-reference-frame {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    margin-block: 1.75rem 0;
    max-width: 100%;
    overflow: clip;
  }

  .main-pane:has(#scalar-reference) {
    isolation: auto;
  }

  .api-spec-anchor {
    display: block;
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
  }

  #scalar-reference {
    min-height: max(42rem, 100vh);
  }

  #scalar-reference > div > .scalar-api-reference {
    --scalar-font:
      "Suisse Intl", "Suisse Intl Fallback", ui-sans-serif, system-ui,
      sans-serif;
    --scalar-font-code: "Suisse Intl Mono", ui-monospace, monospace;
    --scalar-color-accent: #9d5af2;
    --scalar-radius: 8px;
    --scalar-radius-lg: 8px;
    --scalar-radius-xl: 12px;
    --scalar-radius-2xl: 14px;
    --scalar-radius-3xl: 20px;
  }

  :root[data-theme="dark"] #scalar-reference > div > .scalar-api-reference {
    --scalar-background-1: #101010;
    --scalar-background-2: #1d1d1d;
    --scalar-background-3: #272727;
    --scalar-border-color: #373737;
    --scalar-color-1: #f6f6f9;
    --scalar-color-2: #aaa9a9;
    --scalar-color-3: #9c98a8;
    --scalar-link-color: #b07df5;
    --scalar-link-color-hover: #c9a3f8;
    --scalar-sidebar-background-1: #101010;
    --scalar-sidebar-color-1: #f6f6f9;
    --scalar-sidebar-color-2: #aaa9a9;
    --scalar-sidebar-color-active: #ffffff;
    --scalar-sidebar-border-color: #373737;
    --scalar-sidebar-item-active-background: #261b34;
    --scalar-sidebar-item-hover-background: #1d1d1d;
  }

  :root[data-theme="light"] #scalar-reference > div > .scalar-api-reference {
    --scalar-background-1: #ffffff;
    --scalar-background-2: #f6f6f9;
    --scalar-background-3: #e1e1e1;
    --scalar-border-color: #e1e1e1;
    --scalar-color-1: #131216;
    --scalar-color-2: #5f5f5f;
    --scalar-color-3: #737272;
    --scalar-color-blue: #005f9e;
    --scalar-link-color: #661cc4;
    --scalar-link-color-hover: #661cc4;
    --scalar-sidebar-background-1: #ffffff;
    --scalar-sidebar-color-1: #131216;
    --scalar-sidebar-color-2: #5f5f5f;
    --scalar-sidebar-color-active: #101010;
    --scalar-sidebar-border-color: #e1e1e1;
    --scalar-sidebar-item-active-background: #f3e7fe;
    --scalar-sidebar-item-hover-background: #f6f6f9;
  }

  #scalar-reference .sidebar-search-placeholder {
    color: var(--scalar-color-2);
  }

  #scalar-reference .scalar-mcp-layer {
    display: none;
  }

  #scalar-reference .scalar-container.scalar-client--open {
    background: var(--scalar-background-1);
  }

  #scalar-reference a.endpoint {
    min-height: 2rem;
    padding-block: 0.25rem;
  }

  #scalar-reference :focus-visible {
    outline-color: var(--sl-color-accent);
  }

  @media (min-width: 72rem) {
    html:not([data-has-sidebar]) {
      --sl-content-width: 90rem;
    }
  }
</style>
