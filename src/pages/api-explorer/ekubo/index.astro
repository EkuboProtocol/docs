<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Test requests against the live Ekubo API from its OpenAPI specification."
    />
    <link rel="canonical" href="https://docs.ekubo.org/api-explorer/ekubo/" />
    <title>Ekubo API Explorer</title>
  </head>
  <body>
    <div id="app"></div>
    <noscript
      ><p>
        This interactive explorer requires JavaScript. <a href="/"
          >Return to the static documentation</a
        >.
      </p></noscript
    >
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/@scalar/api-reference@1.64.1"></script>
    <script is:inline>
      Scalar.createApiReference("#app", {
        url: "/openapi/ekubo.json",
        theme: "default",
        hideModels: false,
        darkMode: true,
        withDefaultFonts: false,
      });
    </script>
  </body>
</html>
