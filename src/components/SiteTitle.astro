<style>
  @layer starlight.core {
    .site-title {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      min-width: 0;
      color: var(--sl-color-white);
      text-decoration: none;
      white-space: nowrap;
    }

    .site-title__wordmark {
      width: auto;
      height: 1.375rem;
      flex-shrink: 0;
    }

    .site-title__tag {
      padding: 0.125rem 0.4375rem;
      border-radius: 0.5rem;
      color: var(--sl-color-text-accent);
      background: var(--sl-color-accent-low);
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      line-height: 1.4;
    }

    @media (max-width: 30rem) {
      .site-title__tag {
        display: none;
      }

      .site-title__wordmark {
        height: 1.25rem;
      }
    }
  }
</style>
