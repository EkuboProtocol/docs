{
  "name": "ekubo-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync:openapi": "node scripts/sync-openapi.mjs",
    "build": "bun run sync:openapi && astro build",
    "check": "bun run sync:openapi && astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "preview": "astro preview",
    "format": "prettier --write .",
    "deploy": "wrangler pages deploy dist --project-name ekubo-docs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7.1.6",
    "sharp": "^0.35.3",
    "starlight-llms-txt": "^0.11.0",
    "starlight-openapi": "^0.26.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.1"
  }
}
