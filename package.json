{
  "name": "ekubo-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync:openapi": "node scripts/sync-openapi.mjs",
    "sync:redirects": "node scripts/sync-redirects.mjs",
    "build": "bun run sync:openapi && bun run sync:redirects && astro build",
    "check": "bun run sync:openapi && astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:legacy": "node scripts/check-legacy-routes.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check:api": "node scripts/check-api.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "check:browser": "bun run check:a11y && bun run check:overflow && bun run check:theme && bun run check:api",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "wrangler pages deploy dist --project-name ekubo-docs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7.1.6",
    "sharp": "^0.35.3",
    "starlight-llms-txt": "^0.11.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.1"
  }
}
